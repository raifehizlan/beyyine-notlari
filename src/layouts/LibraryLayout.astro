---
import { getCollection, type CollectionEntry } from 'astro:content';
import ReadingTabs from '../components/common/ReadingTabs';
import StickyAudioPlayer from '../components/deeper-look/StickyAudioPlayer';
import { bookHref, formatDate, groupLibrary } from '../lib/content';
import BaseLayout from './BaseLayout.astro';

interface Props {
  note: CollectionEntry<'library'>;
}

const { note } = Astro.props;
const { title, bookTitle, author, category, publishDate, readDate, tags, audio } = note.data;
const book = groupLibrary(await getCollection('library')).find((item) => item.notes.some((entry) => entry.id === note.id));
---

<BaseLayout title={title} description={`${bookTitle} · ${author}`} searchCategory="Kütüphane">
  <article class="mx-auto max-w-3xl px-4 py-8">
    <nav aria-label="Konum" class="text-sm text-slate-500">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a class="hover:text-emerald-700" href="/">Ana Sayfa</a></li>
        <li aria-hidden="true">/</li>
        <li><a class="hover:text-emerald-700" href="/kutuphane">Kütüphane</a></li>
        <li aria-hidden="true">/</li>
        {
          book && (
            <>
              <li>
                <a class="hover:text-emerald-700" href={bookHref(book.slug)}>
                  {book.bookTitle}
                </a>
              </li>
              <li aria-hidden="true">/</li>
            </>
          )
        }
        <li class="text-slate-800 dark:text-slate-100" aria-current="page">{title}</li>
      </ol>
    </nav>

    <p class="mt-6 text-xs font-semibold uppercase tracking-[0.16em] text-amber-800 dark:text-amber-200">{category}</p>
    <h1 class="mt-3 font-serif text-4xl leading-tight text-stone-950 dark:text-amber-50">{title}</h1>
    <p class="mt-4 text-lg text-slate-700 dark:text-slate-200">
      {bookTitle}
      <span class="text-slate-400"> · </span>
      {author}
    </p>
    <p class="mt-2 text-sm text-slate-500">
      Yayım {formatDate(publishDate)}
      {readDate && <span> · Okuma {formatDate(readDate)}</span>}
      {audio?.duration && <span> · {audio.duration}</span>}
    </p>
    {
      audio && (
        <StickyAudioPlayer
          client:load
          title={title}
          subtitle={`${bookTitle} · ${author}`}
          duration={audio.duration}
          mp3DirectUrl={audio.mp3DirectUrl}
          spotifyUrl={audio.spotifyUrl}
          youtubeUrl={audio.youtubeUrl}
        />
      )
    }

    <ReadingTabs
      client:load
      title={title}
      detail={`${bookTitle} · ${author}`}
      tabs={[{ id: 'notlar', label: 'Notlar', download: 'Notları indir' }]}
    />
    <slot />

    {
      tags.length > 0 && (
        <ul class="mt-8 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <li>
              <a
                href={`/kutuphane?etiket=${encodeURIComponent(tag)}`}
                class="rounded-full bg-emerald-700/10 px-3 py-1 text-sm text-emerald-900 dark:text-emerald-100"
              >
                #{tag}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </article>
</BaseLayout>

---
import type { CollectionEntry } from 'astro:content';
import LessonSidebar from '../components/deeper-look/LessonSidebar.astro';
import LessonTabs from '../components/deeper-look/LessonTabs';
import StickyAudioPlayer from '../components/deeper-look/StickyAudioPlayer';
import { formatDate, lessonHref, parseVerseRange, surahHref } from '../lib/content';
import BaseLayout from './BaseLayout.astro';

interface Props {
  lesson: CollectionEntry<'deeper-look'>;
  previous?: CollectionEntry<'deeper-look'>;
  next?: CollectionEntry<'deeper-look'>;
}

const { lesson, previous, next } = Astro.props;
const { title, surahName, surahNumber, verseRange, lessonNumber, publishDate, summary, audio, pdfDownloadUrl, tags, hasNoumanTranscript } =
  lesson.data;

function toLink(entry?: CollectionEntry<'deeper-look'>) {
  if (!entry) return undefined;
  return {
    href: lessonHref(entry),
    title: entry.data.title,
    lessonNumber: entry.data.lessonNumber,
    verseRange: entry.data.verseRange,
  };
}
---

<BaseLayout title={title} description={summary} searchCategory="Tefsir">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-8 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-start">
    <article>
      <nav aria-label="Konum" class="text-sm text-slate-500">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a class="hover:text-emerald-700" href="/">Ana Sayfa</a></li>
          <li aria-hidden="true">/</li>
          <li><a class="hover:text-emerald-700" href="/deeper-look">Tefsir</a></li>
          <li aria-hidden="true">/</li>
          <li>
            <a class="hover:text-emerald-700" href={surahHref(surahNumber)}>{surahName} Sûresi</a>
          </li>
          <li aria-hidden="true">/</li>
          <li class="text-slate-800 dark:text-slate-100" aria-current="page">
            {lessonNumber}. Ders (Ayet {verseRange})
          </li>
        </ol>
      </nav>

      <p class="mt-6 text-xs font-semibold uppercase tracking-[0.16em] text-amber-800 dark:text-amber-200">
        {surahName} · {lessonNumber}. Ders
      </p>
      <h1 class="mt-3 font-serif text-4xl leading-tight text-stone-950 dark:text-amber-50">{title}</h1>
      <p class="mt-4 text-sm text-slate-500">
        Ayet {verseRange}
        {audio.duration && <span> · {audio.duration}</span>}
        <span> · {formatDate(publishDate)}</span>
      </p>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-slate-700 dark:text-slate-300">{summary}</p>

      <StickyAudioPlayer
        client:load
        title={title}
        subtitle={`${surahName} Sûresi · ${lessonNumber}. Ders`}
        duration={audio.duration}
        mp3DirectUrl={audio.mp3DirectUrl}
        spotifyUrl={audio.spotifyUrl}
        youtubeUrl={audio.youtubeUrl}
        pdfDownloadUrl={pdfDownloadUrl}
        pdfTitle={`${title} ders notu`}
      />

      <LessonTabs
        client:load
        title={title}
        detail={`${surahName} Sûresi · Ayet ${verseRange}`}
        showTranscript={hasNoumanTranscript}
      />
      <div id="lesson-panels">
        <slot />
      </div>
    </article>

    <LessonSidebar
      surahName={surahName}
      verses={parseVerseRange(verseRange)}
      tags={tags}
      previous={toLink(previous)}
      next={toLink(next)}
    />
  </div>
</BaseLayout>

---
import { Menu, Search } from 'lucide-astro';
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '/deeper-look', label: 'Tefsir' },
  { href: '/arapca', label: 'Arapça' },
  { href: '/flashcards', label: 'Flashcard' },
  { href: '/kutuphane', label: 'Kütüphane' },
];

const pathname = Astro.url.pathname;
---

<header
  class="sticky top-0 z-40 border-b border-emerald-950/10 bg-paper/90 backdrop-blur dark:border-white/10 dark:bg-night/90"
  data-pagefind-ignore="all"
>
  <div class="mx-auto flex max-w-6xl items-center gap-3 px-4 py-3">
    <a href="/" class="flex min-w-0 items-center gap-3 text-slate-900 dark:text-slate-100">
      <img src="/logo.jpg" alt="" width="44" height="44" class="h-11 w-11 shrink-0 rounded-lg object-cover" />
      <span class="truncate font-serif text-lg leading-tight">Beyyine Notları</span>
    </a>

    <nav class="ml-6 hidden items-center gap-1 lg:flex" aria-label="Ana menü">
      {
        links.map((link) => {
          const active = pathname === link.href || pathname.startsWith(`${link.href}/`);
          return (
            <a
              href={link.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'rounded-full px-3 py-2 text-sm transition',
                active
                  ? 'bg-emerald-700 text-white'
                  : 'text-slate-700 hover:bg-emerald-700/10 dark:text-slate-200',
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <button
        type="button"
        data-open-search
        class="inline-flex h-10 items-center gap-2 rounded-full border border-emerald-950/10 px-3 text-sm text-slate-700 transition hover:border-emerald-700/40 dark:border-white/10 dark:text-slate-200"
      >
        <Search class="h-4 w-4" aria-hidden="true" />
        <span class="hidden sm:inline">Ara</span>
        <kbd class="hidden rounded border border-emerald-950/10 px-1.5 py-0.5 text-[10px] tracking-wide text-slate-500 sm:inline dark:border-white/10">
          Ctrl K
        </kbd>
      </button>
      <ThemeToggle />
      <details class="relative lg:hidden">
        <summary class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full border border-emerald-950/10 text-emerald-800 dark:border-white/10 dark:text-emerald-200 [&::-webkit-details-marker]:hidden">
          <Menu class="h-5 w-5" aria-hidden="true" />
          <span class="sr-only">Menüyü aç</span>
        </summary>
        <nav
          class="absolute right-0 z-50 mt-2 w-52 rounded-2xl border border-emerald-950/10 bg-paper p-2 shadow-lift dark:border-white/10 dark:bg-slate-900"
          aria-label="Mobil menü"
        >
          {
            links.map((link) => (
              <a
                href={link.href}
                class="block rounded-xl px-3 py-2 text-sm text-slate-800 hover:bg-emerald-700/10 dark:text-slate-100"
              >
                {link.label}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  document.querySelectorAll('[data-open-search]').forEach((button) => {
    button.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('beyyine:open-search'));
    });
  });
</script>

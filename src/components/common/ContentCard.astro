---
interface Props {
  href: string;
  eyebrow: string;
  title: string;
  summary: string;
  meta?: string;
}

const { href, eyebrow, title, summary, meta } = Astro.props;
---

<a
  href={href}
  class="group flex h-full flex-col rounded-2xl border border-emerald-950/10 bg-white/75 p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-700/40 hover:shadow-lift dark:border-white/10 dark:bg-slate-900/70"
>
  <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-amber-800 dark:text-amber-200">{eyebrow}</p>
  <h3 class="mt-3 font-serif text-xl leading-snug text-stone-950 group-hover:text-amber-800 dark:text-amber-50 dark:group-hover:text-amber-200">
    {title}
  </h3>
  <p class="mt-2 flex-1 text-sm leading-6 text-slate-600 dark:text-slate-300">{summary}</p>
  {meta && <p class="mt-4 text-xs text-slate-500 dark:text-slate-400">{meta}</p>}
</a>

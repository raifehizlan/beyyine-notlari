---
interface Props {
  class?: string;
  'aria-hidden'?: string | boolean;
}

const { class: className, 'aria-hidden': ariaHidden } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  width="24"
  height="24"
  class={className}
  aria-hidden={ariaHidden}
>
  <circle cx="12" cy="12" r="9"></circle>
  <path d="M8 15.1c2.3-.7 4.8-.5 7 .6"></path>
  <path d="M7.4 12.1c3-.9 6.2-.7 9 .8"></path>
  <path d="M6.9 9.2c3.6-1.1 7.5-.8 10.7 1"></path>
</svg>

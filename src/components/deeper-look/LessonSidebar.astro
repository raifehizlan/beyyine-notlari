---
import { tagHref } from '../../lib/content';

interface LessonLink {
  href: string;
  title: string;
  lessonNumber: number;
  verseRange: string;
}

interface Props {
  surahName: string;
  verses: string[];
  tags: string[];
  previous?: LessonLink;
  next?: LessonLink;
}

const { surahName, verses, tags, previous, next } = Astro.props;
---

<aside class="space-y-6 lg:sticky lg:top-24 lg:self-start">
  <section class="rounded-3xl border border-emerald-950/10 bg-white/70 p-5 dark:border-white/10 dark:bg-slate-900/60">
    <h2 class="font-serif text-lg text-stone-950 dark:text-amber-50">Ayet fihristi</h2>
    <p class="mt-1 text-xs uppercase tracking-[0.14em] text-amber-800 dark:text-amber-200">{surahName}</p>
    <ol class="mt-4 grid grid-cols-4 gap-2">
      {
        verses.map((verse) => (
          <li>
            <a
              href={`#ayet-${verse}`}
              class="flex h-10 items-center justify-center rounded-xl border border-emerald-950/10 text-sm text-slate-700 hover:border-emerald-700 hover:text-emerald-800 dark:border-white/10 dark:text-slate-200"
            >
              {verse}
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="rounded-3xl border border-emerald-950/10 bg-white/70 p-5 dark:border-white/10 dark:bg-slate-900/60">
    <h2 class="font-serif text-lg text-stone-950 dark:text-amber-50">Sûre içi ilerleme</h2>
    <div class="mt-4 space-y-3">
      {
        previous ? (
          <a href={previous.href} class="block rounded-2xl border border-emerald-950/10 px-4 py-3 hover:border-emerald-700/40 dark:border-white/10">
            <span class="text-[11px] uppercase tracking-[0.14em] text-slate-500">Önceki ders</span>
            <span class="mt-1 block text-sm font-medium text-slate-800 dark:text-slate-100">
              {previous.lessonNumber}. Ders · Ayet {previous.verseRange}
            </span>
            <span class="mt-1 block text-sm text-slate-600 dark:text-slate-300">{previous.title}</span>
          </a>
        ) : (
          <p class="rounded-2xl border border-dashed border-emerald-950/15 px-4 py-3 text-sm text-slate-500 dark:border-white/15">
            Önceki ders yok.
          </p>
        )
      }
      {
        next ? (
          <a href={next.href} class="block rounded-2xl border border-emerald-950/10 px-4 py-3 hover:border-emerald-700/40 dark:border-white/10">
            <span class="text-[11px] uppercase tracking-[0.14em] text-slate-500">Sonraki ders</span>
            <span class="mt-1 block text-sm font-medium text-slate-800 dark:text-slate-100">
              {next.lessonNumber}. Ders · Ayet {next.verseRange}
            </span>
            <span class="mt-1 block text-sm text-slate-600 dark:text-slate-300">{next.title}</span>
          </a>
        ) : (
          <p class="rounded-2xl border border-dashed border-emerald-950/15 px-4 py-3 text-sm text-slate-500 dark:border-white/15">
            Sonraki ders yok.
          </p>
        )
      }
    </div>
  </section>

  {
    tags.length > 0 && (
      <section class="rounded-3xl border border-emerald-950/10 bg-white/70 p-5 dark:border-white/10 dark:bg-slate-900/60">
        <h2 class="font-serif text-lg text-stone-950 dark:text-amber-50">Kavram etiketleri</h2>
        <ul class="mt-4 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <li>
              <a
                href={tagHref(tag)}
                class="inline-flex rounded-full bg-amber-100 px-3 py-1 text-sm text-amber-900 hover:bg-amber-200 dark:bg-amber-900/40 dark:text-amber-100"
              >
                #{tag.replace(/\s+/g, '')}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</aside>

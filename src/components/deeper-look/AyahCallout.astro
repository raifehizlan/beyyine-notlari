---
interface Props {
  id?: string;
  arabic: string;
  meal: string;
  reference: string;
}

const { id, arabic, meal, reference } = Astro.props;
---

<figure
  id={id}
  class="not-prose my-8 scroll-mt-28 overflow-hidden rounded-3xl border border-amber-300/80 bg-amber-50 dark:border-amber-700/40 dark:bg-amber-950/30"
>
  <div class="border-b border-amber-300/70 px-5 py-2 text-[11px] font-semibold uppercase tracking-[0.16em] text-amber-700 dark:border-amber-800 dark:text-amber-300">
    {reference}
  </div>
  <div class="px-5 py-6 sm:px-8">
    <p dir="rtl" lang="ar" class="font-arabic text-3xl font-normal leading-[2.7] text-slate-900 sm:text-4xl dark:text-amber-50">
      {arabic}
    </p>
    <figcaption class="mt-5 border-t border-amber-300/60 pt-4 text-base leading-7 text-slate-700 dark:border-amber-800 dark:text-slate-200">
      {meal}
    </figcaption>
  </div>
</figure>

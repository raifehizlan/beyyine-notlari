---
interface Props {
  root: string;
  label?: string;
}

const { root, label } = Astro.props;
---

<span
  class="not-prose mx-1 inline-flex items-center gap-2 rounded-full border border-amber-300 bg-amber-50 px-3 py-1 align-middle dark:border-amber-700/50 dark:bg-amber-950/40"
>
  <span dir="rtl" lang="ar" class="font-arabic text-xl leading-none text-amber-950 dark:text-amber-100">{root}</span>
  {label && <span class="text-xs font-medium uppercase tracking-wide text-amber-800 dark:text-amber-200">{label}</span>}
</span>

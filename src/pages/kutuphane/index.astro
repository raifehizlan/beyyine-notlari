---
import { getCollection } from 'astro:content';
import EntryList from '../../components/common/EntryList.astro';
import { bookHref, formatDate, groupLibrary, withPodcastMeta } from '../../lib/content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const notes = await getCollection('library');
const books = groupLibrary(notes);
const categories = [...new Set(books.map((book) => book.category))].sort((a, b) => a.localeCompare(b, 'tr'));
---

<BaseLayout title="Kütüphane" description="Kitap kitap ayrılmış çalışma notları." searchCategory="Kütüphane">
  <div class="mx-auto max-w-6xl px-4 py-10">
    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-amber-800 dark:text-amber-200">Okuma notları</p>
    <h1 class="mt-3 font-serif text-4xl text-stone-950 dark:text-amber-50">Kütüphane</h1>
    <p class="mt-4 max-w-2xl leading-7 text-slate-600 dark:text-slate-300">
      Her kitap kendi sayfasında durur. Bir eserin bölüm notları o sayfada sırayla açılır.
    </p>
    <div data-tag-banner hidden class="mt-6 flex items-center justify-between gap-3 rounded-2xl bg-amber-100 px-4 py-3 text-sm text-amber-950 dark:bg-amber-900/40 dark:text-amber-50">
      <p>
        Etiket: <strong data-tag-name></strong>
      </p>
      <a href="/kutuphane" class="font-semibold underline">Tüm kitaplar</a>
    </div>
    <p data-tag-empty hidden class="mt-6 text-sm text-slate-500">Bu etiketle eşleşen not yok.</p>

    {
      books.length === 0 ? (
        <p class="mt-8 text-sm text-slate-500">Henüz kitap notu yok.</p>
      ) : (
        <div class="mt-10 space-y-10" data-browse>
          {categories.map((category) => (
            <section>
              <h2 class="font-serif text-2xl text-stone-950 dark:text-amber-50">{category}</h2>
              <div class="mt-4">
                <EntryList
                  items={books
                    .filter((book) => book.category === category)
                    .map((book) => ({
                      href: bookHref(book.slug),
                      kicker: `${book.notes.length} not`,
                      title: book.bookTitle,
                      detail: book.author,
                    }))}
                />
              </div>
            </section>
          ))}
        </div>
      )
    }

    <div class="mt-8" data-tag-results hidden>
      <EntryList
        items={notes.map((note) => ({
          href: `/kutuphane/${note.slug}`,
          kicker: note.data.category,
          title: note.data.title,
          detail: `${note.data.bookTitle} · ${note.data.author}`,
          meta: withPodcastMeta(formatDate(note.data.publishDate), note.data.audio),
          tags: note.data.tags,
        }))}
      />
    </div>
  </div>
</BaseLayout>

<script>
  import '../../scripts/tag-filter.ts';
</script>

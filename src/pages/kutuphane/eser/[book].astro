---
import { getCollection } from 'astro:content';
import EntryList from '../../../components/common/EntryList.astro';
import { formatDate, groupLibrary, withPodcastMeta, type LibraryBook } from '../../../lib/content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const books = groupLibrary(await getCollection('library'));
  return books.map((book) => ({
    params: { book: book.slug },
    props: { book },
  }));
}

interface Props {
  book: LibraryBook;
}

const { book } = Astro.props;
---

<BaseLayout title={book.bookTitle} description={`${book.bookTitle} · ${book.author}`} searchCategory="Kütüphane">
  <div class="mx-auto max-w-3xl px-4 py-10">
    <nav aria-label="Konum" class="text-sm text-slate-500">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a class="hover:text-emerald-700" href="/kutuphane">Kütüphane</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-slate-800 dark:text-slate-100" aria-current="page">{book.bookTitle}</li>
      </ol>
    </nav>

    <p class="mt-6 text-xs font-semibold uppercase tracking-[0.16em] text-amber-800 dark:text-amber-200">{book.category}</p>
    <h1 class="mt-3 font-serif text-4xl leading-tight text-stone-950 dark:text-amber-50">{book.bookTitle}</h1>
    <p class="mt-4 text-lg text-slate-700 dark:text-slate-200">{book.author}</p>
    <p class="mt-2 text-sm text-slate-500">{book.notes.length} not</p>

    <div class="mt-8">
      <EntryList
        items={book.notes.map((note, index) => ({
          href: `/kutuphane/${note.slug}`,
          kicker: String(index + 1),
          title: note.data.title,
          detail: note.data.tags.slice(0, 3).join(' · '),
          meta: withPodcastMeta(formatDate(note.data.publishDate), note.data.audio),
          tags: note.data.tags,
        }))}
      />
    </div>
  </div>
</BaseLayout>

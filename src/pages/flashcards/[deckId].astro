---
import { getCollection, type CollectionEntry } from 'astro:content';
import FlashcardDeck from '../../components/flashcards/FlashcardDeck';
import { flashcardCategoryLabels } from '../../lib/content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const decks = await getCollection('flashcards');
  return decks.map((deck) => ({
    params: { deckId: deck.id },
    props: { deck },
  }));
}

interface Props {
  deck: CollectionEntry<'flashcards'>;
}

const { deck } = Astro.props;
---

<BaseLayout title={deck.data.deckTitle} description={deck.data.description} searchCategory="Flashcard">
  <div class="mx-auto max-w-3xl px-4 py-8">
    <nav aria-label="Konum" class="text-sm text-slate-500">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a class="hover:text-emerald-700" href="/">Ana Sayfa</a></li>
        <li aria-hidden="true">/</li>
        <li><a class="hover:text-emerald-700" href="/flashcards">Flashcard</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-slate-800 dark:text-slate-100" aria-current="page">{deck.data.deckTitle}</li>
      </ol>
    </nav>
    <p class="mt-6 text-xs font-semibold uppercase tracking-[0.16em] text-amber-800 dark:text-amber-200">
      {flashcardCategoryLabels[deck.data.category]}
    </p>
    <h1 class="mt-3 font-serif text-4xl leading-tight text-stone-950 dark:text-amber-50">{deck.data.deckTitle}</h1>
    <p class="mt-4 leading-7 text-slate-600 dark:text-slate-300">{deck.data.description}</p>
    <div class="mt-8">
      <FlashcardDeck client:load cards={deck.data.cards} />
    </div>

    <details class="mt-10 rounded-3xl border border-emerald-950/10 p-5 dark:border-white/10">
      <summary class="cursor-pointer font-serif text-xl text-stone-950 dark:text-amber-50">Destedeki kartlar</summary>
      <ul class="mt-4 space-y-4">
        {
          deck.data.cards.map((card) => (
            <li class="border-t border-emerald-950/10 pt-4 dark:border-white/10">
              <p dir="rtl" lang="ar" class="font-arabic text-3xl leading-loose">
                {card.front.arabic}
              </p>
              <p class="text-sm text-slate-600 dark:text-slate-300">
                {card.back.meaning}
                {card.back.root && <span> · {card.back.root}</span>}
                {card.back.grammarType && <span> · {card.back.grammarType}</span>}
              </p>
            </li>
          ))
        }
      </ul>
    </details>
  </div>
</BaseLayout>

---
import { getCollection } from 'astro:content';
import EntryList from '../../components/common/EntryList.astro';
import { formatDate, lessonHref, sortBySurah, surahHref, verseSpan } from '../../lib/content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const lessons = sortBySurah(await getCollection('deeper-look'));
const groups = new Map<number, { surahName: string; lessons: typeof lessons }>();
for (const lesson of lessons) {
  const group = groups.get(lesson.data.surahNumber) ?? { surahName: lesson.data.surahName, lessons: [] };
  group.lessons.push(lesson);
  groups.set(lesson.data.surahNumber, group);
}
---

<BaseLayout title="Tefsir" description="Sûre sûre ders fihristi." searchCategory="Tefsir">
  <div class="mx-auto max-w-6xl px-4 py-10">
    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-amber-800 dark:text-amber-200">Fihrist</p>
    <h1 class="mt-3 font-serif text-4xl text-stone-950 dark:text-amber-50">Tefsir</h1>
    <p class="mt-4 max-w-2xl leading-7 text-slate-600 dark:text-slate-300">
      Önce sûreyi seçin. O sûrenin dersleri kendi sayfasında, bölüm numarasıyla sıraya dizilir. Notlar, Nouman Ali Khan’ın Bayyinah TV derslerinden derlenen bağımsız çalışmalardır.
    </p>

    <div data-tag-banner hidden class="mt-6 flex flex-wrap items-center justify-between gap-3 rounded-2xl bg-amber-100 px-4 py-3 text-sm text-amber-950 dark:bg-amber-900/40 dark:text-amber-50">
      <p>
        Etiket: <strong data-tag-name></strong>
      </p>
      <a href="/deeper-look" class="font-semibold underline">Tüm sûreler</a>
    </div>
    <p data-tag-empty hidden class="mt-6 text-sm text-slate-500">Bu etiketle eşleşen ders yok.</p>

    <div class="mt-10" data-browse>
      <ul class="divide-y divide-emerald-950/10 overflow-hidden rounded-2xl border border-emerald-950/10 bg-white/75 dark:divide-white/10 dark:border-white/10 dark:bg-slate-900/60" data-pagefind-ignore="all">
        {
          [...groups.entries()].map(([surahNumber, group]) => {
            const span = verseSpan(group.lessons.map((lesson) => lesson.data.verseRange));
            const count = group.lessons.length;
            return (
              <li>
                <a href={surahHref(surahNumber)} class="flex items-baseline gap-4 px-4 py-4 transition hover:bg-amber-50/80 sm:px-5 dark:hover:bg-white/5">
                  <span class="w-10 shrink-0 font-serif text-2xl text-amber-800 dark:text-amber-200">{surahNumber}</span>
                  <span class="min-w-0 flex-1">
                    <span class="block font-serif text-xl text-stone-950 dark:text-amber-50">{group.surahName} Sûresi</span>
                    <span class="mt-0.5 block text-sm text-slate-600 dark:text-slate-300">
                      {count} ders{span && ` · Ayet ${span}`}
                    </span>
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>

    <div class="mt-8" data-tag-results hidden>
      <EntryList
        items={lessons.map((lesson) => ({
          href: lessonHref(lesson),
          kicker: `${lesson.data.lessonNumber}. ders`,
          title: lesson.data.title,
          detail: `${lesson.data.surahName} · Ayet ${lesson.data.verseRange}`,
          meta: formatDate(lesson.data.publishDate),
          tags: lesson.data.tags,
        }))}
      />
    </div>
  </div>
</BaseLayout>

<script>
  import '../../scripts/tag-filter.ts';
</script>

---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Sayfa bulunamadı" description="Aradığınız sayfa bu portalda yok.">
  <div class="mx-auto max-w-xl px-4 py-24 text-center">
    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-amber-800 dark:text-amber-200">404</p>
    <h1 class="mt-3 font-serif text-4xl text-stone-950 dark:text-amber-50">Bu sayfa yok</h1>
    <p class="mt-4 leading-7 text-slate-600 dark:text-slate-300">
      Bağlantı değişmiş olabilir. Fihristten devam edebilir veya aramayı açabilirsiniz.
    </p>
    <a href="/" class="mt-8 inline-flex rounded-full bg-emerald-700 px-5 py-3 text-sm font-semibold text-white">Ana sayfaya dön</a>
  </div>
</BaseLayout>
